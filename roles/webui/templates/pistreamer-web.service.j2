# Managed by pistreamer.
[Unit]
Description=pistreamer web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ ansible_user }}
Group={{ ansible_user }}
WorkingDirectory={{ webui_dir }}
Environment=PISTREAMER_WEB_CONFIG=/etc/pistreamer/web.json
Environment=QBZD_HOST=127.0.0.1:8182
# Bottom of the volume slider, in dB. The raw DAC scale spans 0 to -127 dB,
# which would put -63 dB at half travel; this window keeps the travel useful.
Environment=PISTREAMER_VOLUME_MIN_DB={{ webui_volume_min_db }}
Environment=PISTREAMER_VOLUME_CURVE={{ webui_volume_curve }}
Environment=PISTREAMER_VOLUME_TAPER={{ webui_volume_taper }}
ExecStart={{ webui_dir }}/venv/bin/uvicorn app:app --host {{ webui_bind }} --port {{ webui_port }}
Restart=on-failure
RestartSec=5

# The SSE endpoint holds a connection open indefinitely, so uvicorn never
# finishes a graceful shutdown on its own and systemd waited the full 90 s
# default before SIGKILL — making every redeploy take a minute and a half.
# Ten seconds is ample for a handful of local clients.
TimeoutStopSec=10
KillMode=mixed

# Modest hardening. The app runs subprocesses (the qbzd CLI, and the network
# helper through sudo), so it cannot be fully locked down — but it has no
# business writing outside its own directory.
#
# NoNewPrivileges is deliberately NOT set. It blocks every setuid escalation,
# which is exactly how sudo acquires root, so enabling it breaks Wi-Fi
# configuration with:
#   "sudo: The 'no new privileges' flag is set, which prevents sudo from
#    running as root."
# It also bought little here: the service user already has NOPASSWD: ALL, so
# the flag constrained this one helper and nothing else.
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# /etc/pistreamer must be writable: the first-run wizard creates the password
# file itself. ProtectSystem=full makes /etc read-only, and ReadWritePaths is
# what punches through it — without this entry the wizard cannot save.
ReadWritePaths={{ webui_dir }} /etc/pistreamer /home/{{ ansible_user }}/.config /home/{{ ansible_user }}/.local

[Install]
WantedBy=multi-user.target
